<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body{
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Your URL Shortner</h1>
    <form method="POST" action="/url" >
        <label>Enter Your URL</label>
        <input type="text" name="url" placeholder="http://example.com">
        <button type="submit">Generate</button>
    </form>
    <% if(locals.id){%>
            <p> Short Url :- http://localhost:8001/url/<%= id %> </p>
        <%} %>
    
    <div>
        <% if (locals.allUrls) { %>
         <table>
            <thead>
                <tr>
                    <th>Sr.no.</th>
                    <th>ShortId</th>
                    <th>RedirectURL</th>
                    <th>Taps</th>
                </tr>
            </thead>
            <tbody>
                <% allUrls.forEach((url,index) => { %>
                 <tr>
                    <td><%= index+1 %></td>
                    <td><%= url.shortId %></td>
                    <td><%= url.redirectURL %></td>
                    <td><%= url.visitedHistory.length %></td>
                 </tr>
                <% }) %>
            </tbody>
         </table>
        <% } %>
    </div>
</body>
</html>